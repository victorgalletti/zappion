# Zappion Supabase (api/). Local: `supabase status` shows the URL and anon key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public base URL of the webhook, shown in Settings › Meta App to paste into the Meta
# dashboard. Leave empty to use NEXT_PUBLIC_SUPABASE_URL (e.g. set it to the signup/ proxy domain).
NEXT_PUBLIC_WEBHOOK_BASE_URL=

# Embedded Signup page (signup/server.mjs), hosted on an HTTPS domain registered in the Meta App.
NEXT_PUBLIC_SIGNUP_URL=http://localhost:8787/conectar

# Local login created by `node scripts/seed-dev.mjs` (local Supabase only).
TEST_USER_EMAIL=dev@zappion.test
TEST_USER_PASSWORD=zappion-dev-local
