# Fallback Meta App for every organization without its own (Settings › Meta App keeps an
# organization's App ID, App Secret, system user token and verify token in Supabase Vault instead).
# Several Apps: separate the ids and the secrets with '|' and add ?app_id=<id> to each webhook URL.
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_ID=
META_SYSTEM_USER_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# Public HTTPS base Meta can reach (your domain, or the ngrok URL in development, e.g.
# https://<name>.ngrok-free.dev). Used to build each Meta App's webhook callback URL and by the
# "Configure webhook automatically" button in Settings › Meta App.
WEBHOOK_PUBLIC_URL=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
