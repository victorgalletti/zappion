<Application xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Zappion.Windows.App" xmlns:local="using:Zappion.Windows">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SentBubbleBrush" Color="#dbf8c6"/>
                    <SolidColorBrush x:Key="ReceivedBubbleBrush" Color="#ffffff"/>
                    <SolidColorBrush x:Key="BubbleTextBrush" Color="#000000"/>
                    <SolidColorBrush x:Key="ReadTickBrush" Color="#0da9e5"/>
                    <SolidColorBrush x:Key="UnreadBadgeBrush" Color="#25d366"/>
                    <SolidColorBrush x:Key="ChatAccentBrush" Color="#128c50"/>
                    <SolidColorBrush x:Key="AccentTint10Brush" Color="#1A128C50"/>
                    <SolidColorBrush x:Key="PanelBrush" Color="#f0f2f5"/>
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#ffffff"/>
                    <SolidColorBrush x:Key="LayoutBrush" Color="#e9edef"/>
                    <SolidColorBrush x:Key="LineBrush" Color="#dadada"/>
                    <SolidColorBrush x:Key="HeadingBrush" Color="#111b21"/>
                    <SolidColorBrush x:Key="SubBrush" Color="#54656f"/>
                    <SolidColorBrush x:Key="IconBrush" Color="#667781"/>
                    <SolidColorBrush x:Key="ChatBrush" Color="#e4dcd4"/>
                    <SolidColorBrush x:Key="DateBrush" Color="#e1f2fa"/>
                    <SolidColorBrush x:Key="DateTextBrush" Color="#000000"/>
                    <SolidColorBrush x:Key="UnselectedBrush" Color="#f8f9fa"/>
                    <SolidColorBrush x:Key="InputBrush" Color="#ffffff"/><SolidColorBrush x:Key="DangerBrush" Color="#df3333"/>
                    <SolidColorBrush x:Key="MenuBrush" Color="#ffffff"/>
                    <SolidColorBrush x:Key="NoticeBrush" Color="#fdf4c5"/>
                    <SolidColorBrush x:Key="NoticeTextBrush" Color="#000000"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#f0f2f5"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#f0f2f5"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SentBubbleBrush" Color="#144d37"/>
                    <SolidColorBrush x:Key="ReceivedBubbleBrush" Color="#272727"/>
                    <SolidColorBrush x:Key="BubbleTextBrush" Color="#F2F1F1F2"/>
                    <SolidColorBrush x:Key="ReadTickBrush" Color="#0da9e5"/>
                    <SolidColorBrush x:Key="UnreadBadgeBrush" Color="#25d366"/>
                    <SolidColorBrush x:Key="ChatAccentBrush" Color="#21b866"/>
                    <SolidColorBrush x:Key="AccentTint10Brush" Color="#1A21B866"/>
                    <SolidColorBrush x:Key="PanelBrush" Color="#2c2c2c"/>
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#181818"/>
                    <SolidColorBrush x:Key="LayoutBrush" Color="#111111"/>
                    <SolidColorBrush x:Key="LineBrush" Color="#303030"/>
                    <SolidColorBrush x:Key="HeadingBrush" Color="#E0F1F1F2"/>
                    <SolidColorBrush x:Key="SubBrush" Color="#FFA6A8AA"/>
                    <SolidColorBrush x:Key="IconBrush" Color="#a0a0a0"/>
                    <SolidColorBrush x:Key="ChatBrush" Color="#141414"/>
                    <SolidColorBrush x:Key="DateBrush" Color="#FF1E2A30"/>
                    <SolidColorBrush x:Key="DateTextBrush" Color="#EBF1F1F2"/>
                    <SolidColorBrush x:Key="UnselectedBrush" Color="#181818"/>
                    <SolidColorBrush x:Key="InputBrush" Color="#242624"/><SolidColorBrush x:Key="DangerBrush" Color="#df3333"/>
                    <SolidColorBrush x:Key="MenuBrush" Color="#282828"/>
                    <SolidColorBrush x:Key="NoticeBrush" Color="#FF20272B"/>
                    <SolidColorBrush x:Key="NoticeTextBrush" Color="#FFFAD964"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#2c2c2c"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#2c2c2c"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Mirrors web/components/sidebar.tsx and ui/input.tsx: the input owns its surface in every state. -->
            <local:EmptyTextVisibilityConverter x:Key="EmptyTextVisibility"/>
            <Style TargetType="TextBox" x:Key="WebTextBox">
                <Setter Property="Foreground" Value="{ThemeResource HeadingBrush}"/>
                <Setter Property="Background" Value="{ThemeResource InputBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                            <Border x:Name="InputRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver"/>
                                        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="InputRoot.Opacity" Value="0.5"/></VisualState.Setters></VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="FocusStates"><VisualState x:Name="Focused"/><VisualState x:Name="Unfocused"/><VisualState x:Name="PointerFocused"/></VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid Margin="{TemplateBinding Padding}">
                                    <ScrollViewer x:Name="ContentElement" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Hidden" ZoomMode="Disabled" IsTabStop="False" AutomationProperties.AccessibilityView="Raw"/>
                                    <TextBlock Text="{TemplateBinding PlaceholderText}" Foreground="{ThemeResource SubBrush}" FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding Text, RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource EmptyTextVisibility}}"/>
                                </Grid>
                            </Border>
                        </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource WebTextBox}"/>
            <Style TargetType="TextBox" x:Key="SearchTextBox" BasedOn="{StaticResource WebTextBox}">
                <Setter Property="Background" Value="{ThemeResource PanelBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="20"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                            <Border x:Name="InputRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver"/>
                                        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="InputRoot.Opacity" Value="0.5"/></VisualState.Setters></VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="FocusStates"><VisualState x:Name="Focused"/><VisualState x:Name="Unfocused"/><VisualState x:Name="PointerFocused"/></VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <local:LucideIcon Kind="search" Size="16" IsHitTestVisible="False"/>
                                    <ScrollViewer x:Name="ContentElement" Grid.Column="2" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Hidden" ZoomMode="Disabled" IsTabStop="False" AutomationProperties.AccessibilityView="Raw"/>
                                    <TextBlock Grid.Column="2" Text="{TemplateBinding PlaceholderText}" Foreground="{ThemeResource SubBrush}" FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding Text, RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource EmptyTextVisibility}}"/>
                                </Grid>
                            </Border>
                        </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="SettingsTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="{ThemeResource InputBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource HeadingBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="MinHeight" Value="42"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                    <Border x:Name="FieldRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"/><VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="FieldRoot.Opacity" Value="0.6"/></VisualState.Setters></VisualState></VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused"/>
                                <VisualState x:Name="Focused"><VisualState.Setters><Setter Target="FieldRoot.BorderBrush" Value="{ThemeResource ChatAccentBrush}"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="PointerFocused"><VisualState.Setters><Setter Target="FieldRoot.BorderBrush" Value="{ThemeResource ChatAccentBrush}"/></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid Margin="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="ContentElement" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Hidden" ZoomMode="Disabled" IsTabStop="False" AutomationProperties.AccessibilityView="Raw"/>
                            <TextBlock Text="{TemplateBinding PlaceholderText}" Foreground="{ThemeResource SubBrush}" FontSize="{TemplateBinding FontSize}" IsHitTestVisible="False" Visibility="{Binding Text, RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource EmptyTextVisibility}}"/>
                        </Grid>
                    </Border>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI</FontFamily>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="Foreground" Value="{ThemeResource HeadingBrush}"/>
            </Style>
            <Style x:Key="PlainButton" TargetType="Button">
                <Setter Property="IsTabStop" Value="True"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{ThemeResource IconBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonRoot" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ButtonRoot.Opacity" Value="0.8"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="ButtonRoot.Opacity" Value="0.6"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="ButtonRoot.Opacity" Value="0.5"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ChatListItem" TargetType="ListViewItem">
                <Setter Property="IsTabStop" Value="True"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="MinHeight" Value="76"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border x:Name="ItemRoot" CornerRadius="12" Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ItemRoot.Background" Value="{ThemeResource PanelBrush}"/>
                                                <Setter Target="ItemRoot.Opacity" Value="0.8"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Target="ItemRoot.Background" Value="{ThemeResource PanelBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOverSelected">
                                            <VisualState.Setters>
                                                <Setter Target="ItemRoot.Background" Value="{ThemeResource PanelBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
